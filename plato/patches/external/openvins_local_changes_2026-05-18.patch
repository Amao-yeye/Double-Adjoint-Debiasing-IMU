+void StateHelper::enforce_frozen_imu_bias(std::shared_ptr<State> state) {
+
+  if (!state->_options.freeze_imu_bias) {
+    return;
+  }
+
+  Eigen::MatrixXd imu_x = state->_imu->value();
+  imu_x.block(10, 0, 3, 1) = state->_options.frozen_imu_bias_g;
+  imu_x.block(13, 0, 3, 1) = state->_options.frozen_imu_bias_a;
+  state->_imu->set_value(imu_x);
+
+  Eigen::MatrixXd imu_fej = state->_imu->fej();
+  imu_fej.block(10, 0, 3, 1) = state->_options.frozen_imu_bias_g;
+  imu_fej.block(13, 0, 3, 1) = state->_options.frozen_imu_bias_a;
+  state->_imu->set_fej(imu_fej);
+
+  const double cov = (state->_options.frozen_imu_bias_cov > 0.0) ? state->_options.frozen_imu_bias_cov : 0.0;
+  auto freeze_cov_block = [&](int id, int size) {
+    if (id < 0 || state->_Cov.rows() == 0) {
+      return;
+    }
+    state->_Cov.block(id, 0, size, state->_Cov.cols()).setZero();
+    state->_Cov.block(0, id, state->_Cov.rows(), size).setZero();
+    state->_Cov.block(id, id, size, size) = cov * Eigen::MatrixXd::Identity(size, size);
+  };
+  freeze_cov_block(state->_imu->bg()->id(), state->_imu->bg()->size());
+  freeze_cov_block(state->_imu->ba()->id(), state->_imu->ba()->size());
+}
+
+void StateHelper::add_diagonal_covariance(std::shared_ptr<State> state, std::shared_ptr<Type> variable, double variance) {
+
+  if (state == nullptr || variable == nullptr || variance <= 0.0 || state->_Cov.rows() == 0) {
+    return;
+  }
+  if (variable->id() < 0 || variable->id() + variable->size() > state->_Cov.rows()) {
+    return;
+  }
+
+  state->_Cov.block(variable->id(), variable->id(), variable->size(), variable->size()).diagonal().array() += variance;
+  state->_Cov = state->_Cov.selfadjointView<Eigen::Upper>();
+  enforce_frozen_imu_bias(state);
+}
