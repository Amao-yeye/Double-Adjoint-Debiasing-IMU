+double VioManager::plato_image_mean_intensity(const ov_core::CameraData &message) const {
+
+  if (message.images.empty()) {
+    return 255.0;
+  }
+
+  double mean_sum = 0.0;
+  int valid_images = 0;
+  for (const auto &image : message.images) {
+    if (image.empty()) {
+      continue;
+    }
+    mean_sum += cv::mean(image)[0];
+    valid_images++;
+  }
+  return valid_images > 0 ? mean_sum / valid_images : 255.0;
+}
+
+void VioManager::plato_apply_reentry_stabilization(double timestamp) {
+
+  if (!params.plato_reentry_inflate_covariance) {
+    return;
+  }
+
+  constexpr double kDegToRad = 3.14159265358979323846 / 180.0;
+  const double ori_var = std::pow(params.plato_reentry_ori_std_deg * kDegToRad, 2);
+  const double pos_var = std::pow(params.plato_reentry_pos_std_m, 2);
+  const double vel_var = std::pow(params.plato_reentry_vel_std_mps, 2);
+  const double bg_var = std::pow(params.plato_reentry_bg_std_rad_s, 2);
+  const double ba_var = std::pow(params.plato_reentry_ba_std_m_s2, 2);
+  const double clone_ori_var = std::pow(params.plato_reentry_clone_ori_std_deg * kDegToRad, 2);
+  const double clone_pos_var = std::pow(params.plato_reentry_clone_pos_std_m, 2);
+
+  StateHelper::add_diagonal_covariance(state, state->_imu->q(), ori_var);
+  StateHelper::add_diagonal_covariance(state, state->_imu->p(), pos_var);
+  StateHelper::add_diagonal_covariance(state, state->_imu->v(), vel_var);
+  StateHelper::add_diagonal_covariance(state, state->_imu->bg(), bg_var);
+  StateHelper::add_diagonal_covariance(state, state->_imu->ba(), ba_var);
+
+  for (const auto &clone : state->_clones_IMU) {
+    StateHelper::add_diagonal_covariance(state, clone.second->q(), clone_ori_var);
+    StateHelper::add_diagonal_covariance(state, clone.second->p(), clone_pos_var);
+  }
+
+  propagator->invalidate_cache();
+  PRINT_INFO(YELLOW "[PLATO-REENTRY]: inflated covariance at %.6f with std ori/pos/vel/bg/ba %.2fdeg %.2fm %.2fmps %.5fradps %.4fmps2\n" RESET,
+             timestamp, params.plato_reentry_ori_std_deg, params.plato_reentry_pos_std_m, params.plato_reentry_vel_std_mps,
+             params.plato_reentry_bg_std_rad_s, params.plato_reentry_ba_std_m_s2);
+}
