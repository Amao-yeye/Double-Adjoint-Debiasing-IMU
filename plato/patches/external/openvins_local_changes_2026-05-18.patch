+Eigen::VectorXd Propagator::learned_phys_delta_features(const StateOptions::LearnedBiasPhysDeltaModel &model, bool gyro_model,
+                                                        const Eigen::Vector3d &bg, const Eigen::Vector3d &ba, const Eigen::Vector3d &wm,
+                                                        const Eigen::Vector3d &am, const Eigen::Matrix<double, 6, 1> &imu_delta,
+                                                        const Eigen::Matrix3d &R_Gtoi) const {
+  Eigen::VectorXd features(model.feature_dim);
+  int idx = 0;
+  auto append_vec3 = [&](const Eigen::Vector3d &value) {
+    features.segment(idx, 3) = value;
+    idx += 3;
+  };
+  auto append_scalar = [&](double value) {
+    features(idx) = value;
+    idx += 1;
+  };
+
+  const Eigen::Vector3d bias = gyro_model ? bg : ba;
+  const Eigen::Vector3d ba_for_features = model.use_acc_bias ? ba : Eigen::Vector3d::Zero();
+  const Eigen::Vector3d omega_c = wm - bg;
+  const Eigen::Vector3d f_c = am - ba_for_features;
+  const Eigen::Vector3d g_body = R_Gtoi * Eigen::Vector3d(0.0, 0.0, -_gravity(2));
+  const Eigen::Vector3d a_dyn_body = f_c + g_body;
+
+  const Eigen::Vector3d bias_n = bias / model.bias_scale;
+  const Eigen::Vector3d omega_n = omega_c / 5.0;
+  const Eigen::Vector3d f_n = f_c / 9.81;
+  const Eigen::Vector3d a_dyn_n = a_dyn_body / 9.81;
+  const Eigen::Vector3d g_body_n = g_body / 9.81;
+  append_vec3(bias_n);
+  append_vec3(omega_n);
+  append_vec3(f_n);
+  append_vec3(a_dyn_n);
+  append_vec3(g_body_n);
+  append_scalar(omega_n.norm());
+  append_scalar(f_n.norm());
+  append_scalar(a_dyn_n.norm());
+  append_scalar(g_body_n.norm());
+  append_vec3(omega_n.cwiseProduct(omega_n));
+  append_vec3(f_n.cwiseProduct(f_n));
+  append_vec3(omega_n.cross(f_n));
+  append_vec3(omega_n.cross(g_body_n));
+
+  const Eigen::Vector3d delta_omega_n = imu_delta.block(0, 0, 3, 1) / 0.1;
+  const Eigen::Vector3d delta_f_n = imu_delta.block(3, 0, 3, 1);
+  append_vec3(delta_omega_n);
+  append_vec3(delta_f_n);
+  append_scalar(delta_omega_n.norm());
+  append_scalar(delta_f_n.norm());
+  append_vec3(delta_omega_n.cwiseProduct(delta_omega_n));
+  append_vec3(delta_f_n.cwiseProduct(delta_f_n));
+  append_vec3(delta_omega_n.cross(delta_f_n));
+  append_vec3(omega_n.cross(delta_f_n));
+  append_vec3(delta_omega_n.cross(f_n));
+
+  assert(idx == model.feature_dim);
+  return features;
+}
+
+Eigen::Vector3d Propagator::learned_gyro_bias_dynamics(std::shared_ptr<State> state, const Eigen::Vector3d &bg, const Eigen::Vector3d &ba,
+                                                       const Eigen::Vector3d &wm, const Eigen::Vector3d &am,
+                                                       const Eigen::Matrix<double, 6, 1> &imu_delta,
+                                                       const Eigen::Matrix3d &R_Gtoi) const {
+  const StateOptions &options = state->_options;
+  if (options.learned_bias_dynamics_model == "phys_delta") {
+    return options.learned_bg_phys_delta.evaluate(
+        learned_phys_delta_features(options.learned_bg_phys_delta, true, bg, ba, wm, am, imu_delta, R_Gtoi));
+  }
+  return options.learned_bg_c + options.learned_bg_Wb * bg + options.learned_bg_Ww * wm + options.learned_bg_Wa * am;
+}
+
+Eigen::Vector3d Propagator::learned_accel_bias_dynamics(std::shared_ptr<State> state, const Eigen::Vector3d &bg, const Eigen::Vector3d &ba,
+                                                        const Eigen::Vector3d &wm, const Eigen::Vector3d &am,
+                                                        const Eigen::Matrix<double, 6, 1> &imu_delta,
+                                                        const Eigen::Matrix3d &R_Gtoi) const {
+  const StateOptions &options = state->_options;
+  if (options.learned_bias_dynamics_model == "phys_delta") {
+    return options.learned_ba_phys_delta.evaluate(
+        learned_phys_delta_features(options.learned_ba_phys_delta, false, bg, ba, wm, am, imu_delta, R_Gtoi));
+  }
+  return options.learned_ba_c + options.learned_ba_Wb * ba + options.learned_ba_Ww * wm + options.learned_ba_Wa * am;
+}
+
+void Propagator::predict_learned_biases(std::shared_ptr<State> state, double dt, const Eigen::Vector3d &wm, const Eigen::Vector3d &am,
+                                        const Eigen::Matrix<double, 6, 1> &imu_delta, const Eigen::Matrix3d &R_Gtoi,
+                                        Eigen::Vector3d &new_bg, Eigen::Vector3d &new_ba) const {
+  const Eigen::Vector3d bg = new_bg;
+  const Eigen::Vector3d ba = new_ba;
+  new_bg = bg + learned_gyro_bias_dynamics(state, bg, ba, wm, am, imu_delta, R_Gtoi) * dt;
+  new_ba = ba + learned_accel_bias_dynamics(state, bg, ba, wm, am, imu_delta, R_Gtoi) * dt;
+}
+
+Eigen::Matrix<double, 6, 6> Propagator::learned_bias_dynamics_jacobian(std::shared_ptr<State> state, const Eigen::Vector3d &bg,
+                                                                        const Eigen::Vector3d &ba, const Eigen::Vector3d &wm,
+                                                                        const Eigen::Vector3d &am,
+                                                                        const Eigen::Matrix<double, 6, 1> &imu_delta,
+                                                                        const Eigen::Matrix3d &R_Gtoi) const {
+  Eigen::Matrix<double, 6, 6> jac = Eigen::Matrix<double, 6, 6>::Zero();
+  if (state->_options.learned_bias_dynamics_model == "affine") {
+    jac.block(0, 0, 3, 3) = state->_options.learned_bg_Wb;
+    jac.block(3, 3, 3, 3) = state->_options.learned_ba_Wb;
+    return jac;
+  }
+
+  const double eps = 1e-6;
+  auto eval = [&](const Eigen::Vector3d &bg_eval, const Eigen::Vector3d &ba_eval) {
+    Eigen::Matrix<double, 6, 1> out;
+    out.block(0, 0, 3, 1) = learned_gyro_bias_dynamics(state, bg_eval, ba_eval, wm, am, imu_delta, R_Gtoi);
+    out.block(3, 0, 3, 1) = learned_accel_bias_dynamics(state, bg_eval, ba_eval, wm, am, imu_delta, R_Gtoi);
+    return out;
+  };
+  for (int i = 0; i < 6; i++) {
+    Eigen::Vector3d bg_plus = bg;
+    Eigen::Vector3d bg_minus = bg;
+    Eigen::Vector3d ba_plus = ba;
+    Eigen::Vector3d ba_minus = ba;
+    if (i < 3) {
+      bg_plus(i) += eps;
+      bg_minus(i) -= eps;
+    } else {
+      ba_plus(i - 3) += eps;
+      ba_minus(i - 3) -= eps;
+    }
+    jac.col(i) = (eval(bg_plus, ba_plus) - eval(bg_minus, ba_minus)) / (2.0 * eps);
+  }
+  return jac;
+}
