+def cuda_profile_enabled(device) -> bool:
+    return torch.cuda.is_available() and str(device).startswith("cuda")
+
+def start_epoch_profile(device) -> float:
+    if cuda_profile_enabled(device):
+        torch.cuda.synchronize()
+        torch.cuda.reset_peak_memory_stats()
+    return time.perf_counter()
+
+def finish_epoch_profile(device, start_time: float) -> tuple[float, float]:
+    if cuda_profile_enabled(device):
+        torch.cuda.synchronize()
+        peak_memory_mb = torch.cuda.max_memory_allocated() / 1024 ** 2
+    else:
+        peak_memory_mb = 0.0
+    return time.perf_counter() - start_time, peak_memory_mb
+
+def write_stage_profile(output_dir: str, stage_name: str, epoch_times: list[float], gpu_memory: list[float]) -> dict:
+    if len(epoch_times) != len(gpu_memory):
+        raise ValueError("epoch_times and gpu_memory should have the same length")
+
+    profile_dir = os.path.join(output_dir, "profiling")
+    os.makedirs(profile_dir, exist_ok=True)
+    csv_path = os.path.join(profile_dir, f"{stage_name}_epoch_profile.csv")
+    with open(csv_path, "w") as f:
+        f.write("epoch,epoch_time_s,peak_gpu_memory_mb\n")
+        for epoch_idx, (epoch_time, memory_mb) in enumerate(zip(epoch_times, gpu_memory)):
+            f.write(f"{epoch_idx},{epoch_time:.6f},{memory_mb:.2f}\n")
+
+    if epoch_times:
+        time_tensor = torch.tensor(epoch_times, dtype=torch.float64)
+        memory_tensor = torch.tensor(gpu_memory, dtype=torch.float64)
+        summary = {
+            "stage": stage_name,
+            "num_epochs": len(epoch_times),
+            "total_epoch_time_s": float(time_tensor.sum().item()),
+            "avg_epoch_time_s": float(time_tensor.mean().item()),
+            "min_epoch_time_s": float(time_tensor.min().item()),
+            "max_epoch_time_s": float(time_tensor.max().item()),
+            "avg_peak_gpu_memory_mb": float(memory_tensor.mean().item()),
+            "max_peak_gpu_memory_mb": float(memory_tensor.max().item()),
+            "csv_path": csv_path,
+        }
+    else:
+        summary = {
+            "stage": stage_name,
+            "num_epochs": 0,
+            "total_epoch_time_s": 0.0,
+            "avg_epoch_time_s": 0.0,
+            "min_epoch_time_s": 0.0,
+            "max_epoch_time_s": 0.0,
+            "avg_peak_gpu_memory_mb": 0.0,
+            "max_peak_gpu_memory_mb": 0.0,
+            "csv_path": csv_path,
+        }
+
+    with open(os.path.join(profile_dir, f"{stage_name}_profile_summary.yaml"), "w") as f:
+        yaml.safe_dump(summary, f, sort_keys=False)
+    return summary
+
+def format_training_profile(total_time_s: float, gyro_profile: dict | None, acc_profile: dict | None, extra: dict | None = None) -> str:
+    profiles = [p for p in (gyro_profile, acc_profile) if p is not None]
+    max_memory = max((p["max_peak_gpu_memory_mb"] for p in profiles), default=0.0)
+    avg_epoch_time = sum((p["avg_epoch_time_s"] * p["num_epochs"] for p in profiles), 0.0)
+    num_epochs = sum((p["num_epochs"] for p in profiles), 0)
+    avg_epoch_time = avg_epoch_time / num_epochs if num_epochs else 0.0
+
+    lines = [
+        f"Time for training: {total_time_s}",
+        f"Max GPU Memory Allocated: {max_memory:.2f} MB",
+        f"Average optimization epoch time: {avg_epoch_time:.6f} s",
+    ]
+    for profile in profiles:
+        stage = profile["stage"]
+        lines.extend([
+            f"{stage} epochs: {profile['num_epochs']}",
+            f"{stage} total epoch time: {profile['total_epoch_time_s']:.6f} s",
+            f"{stage} avg epoch time: {profile['avg_epoch_time_s']:.6f} s",
+            f"{stage} max epoch time: {profile['max_epoch_time_s']:.6f} s",
+            f"{stage} avg peak GPU memory: {profile['avg_peak_gpu_memory_mb']:.2f} MB",
+            f"{stage} max peak GPU memory: {profile['max_peak_gpu_memory_mb']:.2f} MB",
+            f"{stage} epoch profile csv: {profile['csv_path']}",
+        ])
+    if extra:
+        lines.extend(f"{key}: {value}" for key, value in extra.items())
+    return "\n".join(lines) + "\n"
+
