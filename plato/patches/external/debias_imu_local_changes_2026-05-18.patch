-    axes[0].set_ylabel("gyro bias (rad/s)")
-    axes[1].set_ylabel("acc bias (m/s^2)")
-    axes[1].set_xlabel("time (s)")
-    axes[0].set_title(f"{sequence} bias trends, moving average window={window}")
-    for ax in axes:
